rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reviews — approved ones are public, authenticated can create
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Site stats — anyone can read, anyone can update counters
    match /siteStats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Comments — approved ones public, authenticated can create
    match /comments/{commentId} {
      allow read: if resource.data.approved == true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Contact messages — no public read, anyone can submit
    match /messages/{messageId} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
