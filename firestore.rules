rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reviews — approved ones are public, authenticated can create
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Site stats — anyone can read, anyone can update counters
    match /siteStats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Comments — approved ones public, authenticated can create
    match /comments/{commentId} {
      allow read: if resource.data.approved == true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Contact messages — no public read, anyone can submit
    match /messages/{messageId} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    // Live presence — one doc per anonymous visitor, 45s TTL enforced
    // client-side (stale docs are filtered out, not read as viewers).
    match /presence/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'color', 'x', 'y', 'page', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 32
        && request.resource.data.x is number
        && request.resource.data.x >= -10000 && request.resource.data.x <= 10000
        && request.resource.data.y is number
        && request.resource.data.y >= -10000 && request.resource.data.y <= 10000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 120;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
